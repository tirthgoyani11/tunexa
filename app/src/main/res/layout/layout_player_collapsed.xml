<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/motion_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.xapps.media.xmusic.widget.SongCover
        android:id="@+id/cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:elevation="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/placeholder_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/music_progress" />
        
    <View 
        android:id="@+id/placement_helper" 
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
 
    <com.xapps.media.xmusic.widget.MarqueeTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:text="No Song Playing"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/placement_helper"
        app:layout_constraintEnd_toStartOf="@id/action_prev"
        app:layout_constraintTop_toTopOf="@id/placement_helper"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.xapps.media.xmusic.widget.MarqueeTextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:textSize="13sp"
        android:text="Choose music to start"
        app:layout_constraintStart_toEndOf="@id/placement_helper"
        app:layout_constraintEnd_toStartOf="@id/action_prev"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toBottomOf="@id/placement_helper" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="18dp"
        style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
        android:background="@android:color/transparent"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_skip_previous_filled"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/action"
        app:layout_constraintTop_toTopOf="@id/action"
        app:layout_constraintBottom_toBottomOf="@id/action" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="20dp"
        style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
        app:icon="@drawable/ic_play"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintEnd_toStartOf="@id/action_next"
        app:layout_constraintTop_toTopOf="@id/placement_helper"
        app:layout_constraintBottom_toBottomOf="@id/placement_helper" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="18dp"
        style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
        android:background="@android:color/transparent"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_skip_next_filled"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/action"
        app:layout_constraintBottom_toBottomOf="@id/action" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/music_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:progress="0"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="@android:color/transparent"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="2dp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placement_helper"/>

</androidx.constraintlayout.widget.ConstraintLayout>
